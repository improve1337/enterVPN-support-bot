# Шаблон окружения. Скопируйте в .env и заполните.
#   Локально:   copy .env.example .env
#   На хостинге: значения вбиваются в панель окружения (файл .env туда не заливайте).

# --- Telegram (обязательно) ---
BOT_TOKEN=123456789:AA-your-token-here
BOT_USERNAME=EnterseviceSupport_bot
ADMIN_IDS=123456789
# ADMIN_ID=123456789            # альтернативное имя, поддерживается тоже

# --- Бренд ---
BRAND_NAME=EnterVPN

# --- Режим работы ---
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# --- Окружение ---
# НА ХОСТИНГЕ: обязательно production.
NODE_ENV=development

# --- Данные ---
# ЛОКАЛЬНО:   ./data/support.db
# В DOCKER:   /app/data/support.db (persistent-том)
DATABASE_PATH=./data/support.db
BANNER_PATH=./welcomepic.png

# --- Прокси для Telegram Bot API ---
# Нужен, если хостинг/провайдер блокирует api.telegram.org.
# TELEGRAM_PROXY=socks5://127.0.0.1:1080
