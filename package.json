{
  "name": "entervpn-support-bot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "EnterVPN support bot — тикеты для службы поддержки",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
